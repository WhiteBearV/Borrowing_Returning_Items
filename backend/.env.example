# ─────────────────────────────────────────────────────────────────────────
# .env สำหรับเครื่อง dev เท่านั้น:  cp .env.example .env  แล้วแก้ค่า
# production ใช้ไฟล์ .env ที่ root ของโปรเจกต์ (ดู .env.prod.example) ไม่อ่านไฟล์นี้
# คำอธิบายทุกตัวแปร: README.md หัวข้อ 4
# ─────────────────────────────────────────────────────────────────────────

# Database — ตรงกับ service db ใน docker-compose.yml (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/equipment_borrow

# JWT — สุ่มด้วย: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (FastAPI-Mail) — false = ไม่ส่งจริง พิมพ์อีเมล (รวมลิงก์ยืนยัน) ลง log ของ backend แทน
# MAIL_PASSWORD ของ Gmail ต้องเป็น App Password 16 ตัว ไม่ใช่รหัส Gmail ปกติ
ENABLE_EMAIL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# App — FRONTEND_URL ใช้ประกอบลิงก์ในอีเมล + CORS (ใส่ IP เครื่องแทน localhost ถ้าจะทดสอบจากมือถือ)
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
# เอกสารที่มีข้อมูลส่วนบุคคล (ใบยืมที่เซ็นแล้ว) — ห้ามอยู่ใน UPLOAD_DIR ที่ถูกเสิร์ฟสาธารณะ
PRIVATE_UPLOAD_DIR=./private_uploads
IMPORT_DIR=./import_tmp

# Email domain ที่อนุญาตให้ลงทะเบียน (comma-separated)
ALLOWED_EMAIL_DOMAINS=cdti.ac.th,student.cdti.ac.th

# true = สมัครแล้วใช้ได้ทันทีไม่ต้องยืนยันอีเมล (สะดวกตอน dev) — ห้ามเปิดใน production
DEV_AUTO_VERIFY_EMAIL=false

# pytest ปฏิเสธ DB ที่ชื่อไม่ลงท้าย _test — เปิดเฉพาะเครื่อง dev ที่ยืนยันแล้วว่าไม่ใช่ข้อมูลจริง
PYTEST_ALLOW_DB=false

# LINE OA (เผื่ออนาคต)
LINE_CHANNEL_ACCESS_TOKEN=
