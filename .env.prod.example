# ─────────────────────────────────────────────────────────────────────────
# ตัวแปรสำหรับ deploy จริง (docker-compose.prod.yml)
#
#   cp .env.prod.example .env     แล้วแก้ค่าให้ครบก่อน up
#
# ไฟล์นี้อยู่ที่ root เพราะ docker compose อ่าน .env ที่ root อัตโนมัติ
# ทั้งสำหรับแทนค่า ${VAR} ในไฟล์ compose และส่งเข้า container ผ่าน env_file
# (backend/.env เป็นไฟล์ของ dev เท่านั้น prod ไม่โหลด)
# ─────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL ไม่ต้องตั้งที่นี่ — compose ประกอบให้เองจาก 3 ค่านี้ ชี้ไป host `db`
POSTGRES_DB=equipment_borrow
POSTGRES_USER=equipment
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสยาว ๆ สุ่มเอา

# ── JWT ──────────────────────────────────────────────────────────────────
# สุ่มด้วย: openssl rand -hex 32
# ถ้าไม่ตั้ง แอปจะไม่ยอมบูตเลย (config.py:22 บังคับ ไม่มีค่า default)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email ────────────────────────────────────────────────────────────────
# ปิดไว้ก่อนช่วงทดสอบ — ตั้ง true พร้อมค่า MAIL_* จริงตอนพร้อมส่งอีเมลจริง
# ถ้าปล่อยว่างหรือทิ้งค่า placeholder ไว้ ระบบจะไม่ส่งเมลจริงแต่ไม่ error
# (utils/email.py ตั้ง SUPPRESS_SEND เอง) — main.py จะพิมพ์เตือนตอน startup
ENABLE_EMAIL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── App ──────────────────────────────────────────────────────────────────
# ทั้งสองค่าต้องเป็น URL ที่ "ผู้ใช้พิมพ์ในเบราว์เซอร์" ไม่ใช่ localhost
# เพราะลิงก์ยืนยันอีเมล/รีเซ็ตรหัสผ่านถูกประกอบจากค่านี้ ตั้งผิด = ผู้ใช้กดลิงก์ไม่ได้
# ไม่ต้องใส่ :8000 — backend อยู่หลัง nginx ที่ path /api
# เปลี่ยนเป็น https แล้ว (nginx :80 redirect ไป :443 self-signed cert เอง — ดู gen-self-signed-cert.sh)
FRONTEND_URL=https://192.168.1.164
APP_BASE_URL=https://192.168.1.164

UPLOAD_DIR=./uploads
ALLOWED_EMAIL_DOMAINS=cdti.ac.th,student.cdti.ac.th

# ── ความปลอดภัย ──────────────────────────────────────────────────────────
# true = สมัครแล้วใช้ได้ทันทีโดยไม่ต้องยืนยันอีเมล
# ห้ามเป็น true ใน production: ใครก็สมัครด้วยอีเมล @cdti.ac.th ที่ไม่ใช่ของตัวเองแล้วเข้าใช้ได้
# ตั้ง true ได้ชั่วคราวเฉพาะกรณี SMTP ยังใช้ไม่ได้ และต้องปิดหน้าสมัครเองควบคู่ไปด้วย
DEV_AUTO_VERIFY_EMAIL=false

# ── LINE OA (ยังไม่ใช้ในเฟสนี้) ──────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
